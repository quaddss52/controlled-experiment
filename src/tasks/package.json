{
  "name": "ai-code-experiment",
  "version": "1.0.0",
  "description": "Controlled experiment comparing AI-assisted and manual TypeScript code",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ --ext .ts",
    "lint:report": "eslint src/ --ext .ts --format json --output-file eslint-report.json",
    "build": "tsc",
    "evaluate": "bash scripts/evaluate.sh",
    "collect-metrics": "ts-node scripts/collect-metrics.ts"
  },
  "keywords": ["experiment", "ai-assisted-coding", "typescript", "research"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "eslint-plugin-complexity": "^1.0.2",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
